{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>jonapoul/renovate-config:default.json5",
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      // The gradle image is used by both docker/Dockerfile and the container in release.yml, which are handled by
      // different managers. Group them so the two references can't drift apart. Schedule is set explicitly here to
      // override the default github-actions rule, otherwise the group would have two conflicting schedules
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "gradle"
      ],
      "groupName": "gradle docker image",
      "schedule": [
        "at any time"
      ]
    }
  ]
}
